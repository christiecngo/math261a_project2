# 1. Calculate the NA count and percentage for each column
missing_data_summary <- dm %>%
summarise_all(.funs = funs(
n_missing = sum(is.na(.)),
pct_missing = mean(is.na(.)) * 100
)) %>%
# Transpose the data frame for easier viewing (rows become columns)
tidyr::pivot_longer(
cols = everything(),
names_to = "Metric",
values_to = "Value"
) %>%
# Separate the variable name from the metric (n_missing or pct_missing)
tidyr::separate(
Metric,
into = c("Variable", "Type"),
sep = "_",
extra = "merge"
) %>%
# Pivot back to wide format so n_missing and pct_missing are columns
tidyr::pivot_wider(
names_from = Type,
values_from = Value
) %>%
# Arrange by percentage missing in descending order
arrange(desc(pct_missing))
# 2. Print the results (show only columns with NAs)
# The full data frame has 29 columns, so we look at all of them
print(missing_data_summary)
