tidy.train <- function(x, ...) {
best_lambda <- x$bestTune$lambda
coefs <- coef(x$finalModel, s = best_lambda)
# 3. Convert the sparse matrix to a data frame in the required 'tidy' format
coefs %>%
as.matrix() %>%
as.data.frame() %>%
rownames_to_column(var = "term") %>%
rename(estimate = !!sym(colnames(.)[2])) %>%
filter(estimate != 0)
}
